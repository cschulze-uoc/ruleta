    <string name="help_no_coins_title">Que se passe-t-il quand vous n\'avez plus de pièces</string>
    <string name="help_no_coins_text">Si vous n\'avez plus de pièces, la partie se termine et vous ne pouvez plus continuer à miser. À ce moment-là, le résultat final s\'affiche et vous pouvez revenir au menu pour commencer une nouvelle partie ou consulter l\'historique.</string>

    <string name="help_save_games_title">Comment les parties sont enregistrées</string>
    <string name="help_save_games_text">À la fin d\'une partie, ses données sont enregistrées dans la base de données locale de l\'appareil. Ainsi, l\'application peut ensuite afficher l\'historique des parties et conserver les informations entre différentes utilisations de l\'application.</string>

    <string name="help_location_title">Localisation dans l\'historique</string>
    <string name="help_location_text">Si l\'utilisateur accorde l\'autorisation de localisation, l\'application peut enregistrer la position approximative de la partie avec le reste des données. Cette information peut ensuite être consultée dans l\'historique.</string>

    <string name="help_notification_title">Notification de victoire</string>
    <string name="help_notification_text">Si vous gagnez une partie, l\'application affichera une notification Android. Depuis cette notification, il est possible de consulter la durée de la partie.</string>

    <string name="help_lang_code">fr</string>
    <string name="help_page_title">Aide - Roulette</string>
    <string name="help_title">Aide du jeu</string>
    <string name="help_image_alt">Image de la roulette</string>

    <string name="help_intro">Dans cette section, vous pouvez consulter rapidement le fonctionnement de l\'application, les types de paris disponibles et la meilleure façon d\'utiliser vos pièces pendant la partie.</string>

    <string name="help_objective_title">Objectif</string>
    <string name="help_objective_text">L\'objectif du jeu est de miser vos pièces à chaque tour et d\'essayer de terminer avec la plus grande quantité possible. Plus vos décisions sont bonnes, meilleur pourra être votre score final.</string>

    <string name="help_navigation_title">Écrans de l\'application</string>
    <string name="help_navigation_home_label">Écran principal :</string>
    <string name="help_navigation_home_text">depuis cet écran, vous pouvez commencer une nouvelle partie, consulter l\'historique et accéder aux autres options de l\'application.</string>
    <string name="help_navigation_game_label">Écran de jeu :</string>
    <string name="help_navigation_game_text">c\'est ici que vous placez vos paris, lancez la roulette et voyez le résultat de chaque tour.</string>
    <string name="help_navigation_history_label">Historique :</string>
    <string name="help_navigation_history_text">affiche les parties enregistrées précédemment afin que vous puissiez consulter les résultats et comparer les scores.</string>
    <string name="help_navigation_settings_label">Paramètres et langue :</string>
    <string name="help_navigation_settings_text">permet d\'adapter l\'application à votre langue ou à d\'autres préférences disponibles.</string>

    <string name="help_how_to_play_title">Comment jouer</string>
    <string name="help_how_to_play_step_1">Saisissez le nom du joueur avant de commencer la partie.</string>
    <string name="help_how_to_play_step_2">Vérifiez le nombre de pièces disponibles avant de placer un pari.</string>
    <string name="help_how_to_play_step_3">Sélectionnez le type de pari que vous souhaitez effectuer.</string>
    <string name="help_how_to_play_step_4">Appuyez sur le bouton pour faire tourner la roulette et attendez le résultat.</string>
    <string name="help_how_to_play_step_5">Selon le résultat, vous gagnerez ou perdrez des pièces et pourrez continuer à jouer jusqu\'à la fin de la partie.</string>

    <string name="help_bets_title">Types de pari</string>
    <string name="help_bet_red_black_title">Rouge / Noir :</string>
    <string name="help_bet_red_black_text">vous gagnez si la couleur obtenue correspond à celle que vous avez choisie.</string>
    <string name="help_bet_even_odd_title">Pair / Impair :</string>
    <string name="help_bet_even_odd_text">vous gagnez si le numéro obtenu correspond à la parité sélectionnée.</string>
    <string name="help_bet_exact_title">Numéro exact :</string>
    <string name="help_bet_exact_text">offre une récompense plus élevée, mais c\'est l\'option la plus difficile à réussir.</string>

    <string name="help_coins_title">Pièces et stratégie</string>
    <string name="help_coins_text">Les pièces représentent votre solde pendant la partie. Chaque pari affecte directement ce solde, il est donc conseillé de bien réfléchir à la somme à risquer et au moment de le faire.</string>
    <string name="help_tip_label">Conseil :</string>
    <string name="help_coins_tip">si vous pariez de manière impulsive, vous risquez de manquer rapidement de pièces. Jouer avec équilibre donne généralement de meilleurs résultats à long terme.</string>

    <string name="help_history_title">Historique des parties</string>
    <string name="help_history_text">L\'historique vous permet de consulter les parties précédemment enregistrées sur l\'appareil. Il est utile pour suivre votre progression et comparer vos meilleurs scores.</string>

    <string name="help_recommendations_title">Recommandations d\'utilisation</string>
    <string name="help_recommendations_1">Lisez attentivement les textes de chaque écran avant de jouer pour la première fois.</string>
    <string name="help_recommendations_2">Vérifiez vos pièces avant chaque tour afin d\'éviter des paris trop risqués sans marge.</string>
    <string name="help_recommendations_3">Consultez l\'historique à la fin de chaque partie pour comparer vos résultats.</string>

    <string name="help_footer">Roulette - écran d\'aide</string>


</resources>
